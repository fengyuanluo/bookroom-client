# Optional build-time settings. The BookRoom server address is chosen at sign-in
# (native apps) or is the origin serving the web build, so it is not set here.

# OAuth client ids for the Google Drive / OneDrive file-sync backends.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=

# Where the CJK webfont bundles are served from (Readest's CDN only answers CORS
# for its own origins).
NEXT_PUBLIC_FONT_BASE_URL=
